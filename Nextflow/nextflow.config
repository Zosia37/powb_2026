apptainer.enabled = true
workflow.output.mode = 'rellink'

profiles {
    standard {
        executor.name = 'local'
        executor.cpus = 30
    }
}

params {
    query       = "${projectDir}/input/queries.fna"
    genomesDir  = "${projectDir}/genomes_test"
    qcovs       = 100
}

report {
    enabled   = true
    overwrite = true
    file      = 'reports/report.html'
}

timeline {
    enabled   = true
    overwrite = true
    file      = 'reports/timeline.html'
}

